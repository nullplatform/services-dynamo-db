#!/bin/bash
set -euo pipefail

# ---------------------------------------------------------------------------
# do_tofu — Copies the Terraform module to OUTPUT_DIR and executes tofu.
#
# Expected environment variables (set by build_context or build_permissions_context):
#   OUTPUT_DIR          — working directory for this execution
#   TOFU_MODULE_DIR     — path to the Terraform module (deployment/ or permissions/)
#   TOFU_INIT_VARIABLES — -backend-config= flags for tofu init
#   TOFU_VARIABLES      — -var= flags for tofu apply/destroy
#
# Set by the workflow YAML configuration block:
#   TOFU_ACTION         — "apply" or "destroy"
# ---------------------------------------------------------------------------

TOFU_ACTION="${TOFU_ACTION:-apply}"

# ---------------------------------------------------------------------------
# Resolve a tofu that supports S3 native state locking (use_lockfile, 1.10+).
# Preference: a supported tofu already on PATH, then the download cache, then a
# fresh download. The cache path is keyed by version and every candidate is
# version-checked, so a binary left in /tmp by another package or an older
# revision of this one is never reused.
# ---------------------------------------------------------------------------
TOFU_VERSION="1.11.6"
TOFU_CACHE_DIR="/tmp/np-tofu-bin/${TOFU_VERSION}"

tofu_version_of() {
  "$1" version 2>/dev/null | head -1 | sed -n 's/^OpenTofu v\([0-9][0-9.]*\).*/\1/p'
}

tofu_supports_lockfile() {
  local version major minor
  version="$(tofu_version_of "$1")"
  [ -n "$version" ] || return 1
  major="${version%%.*}"
  minor="${version#*.}"
  minor="${minor%%.*}"
  case "${major}${minor}" in
    "" | *[!0-9]*) return 1 ;;
  esac
  [ "$major" -gt 1 ] || { [ "$major" -eq 1 ] && [ "$minor" -ge 10 ]; }
}

install_tofu() {
  local staging
  staging="$(mktemp -d /tmp/np-tofu-install.XXXXXX)"
  # shellcheck disable=SC2064
  trap "rm -rf '$staging'" EXIT
  curl -fsSL \
    "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_linux_amd64.zip" \
    -o "${staging}/tofu.zip"
  unzip -qo "${staging}/tofu.zip" tofu -d "$staging"
  chmod +x "${staging}/tofu"
  mkdir -p "$TOFU_CACHE_DIR"
  mv -f "${staging}/tofu" "${TOFU_CACHE_DIR}/tofu"
  rm -rf "$staging"
  trap - EXIT
}

if tofu_supports_lockfile tofu; then
  TOFU_BIN="$(command -v tofu)"
elif tofu_supports_lockfile "${TOFU_CACHE_DIR}/tofu"; then
  TOFU_BIN="${TOFU_CACHE_DIR}/tofu"
else
  echo "Installing tofu v${TOFU_VERSION} to ${TOFU_CACHE_DIR}..."
  install_tofu
  TOFU_BIN="${TOFU_CACHE_DIR}/tofu"
fi

TOFU_BIN_DIR="$(dirname "$TOFU_BIN")"
export PATH="${TOFU_BIN_DIR}:$PATH"

if ! tofu_supports_lockfile "$TOFU_BIN"; then
  echo "" >&2
  echo "ERROR: ${TOFU_BIN} reports version '$(tofu_version_of "$TOFU_BIN")' and cannot" >&2
  echo "       init the S3 backend with use_lockfile=true. OpenTofu 1.10.0+ is required." >&2
  echo "" >&2
  exit 1
fi

echo "Using tofu v$(tofu_version_of "$TOFU_BIN") (${TOFU_BIN})"

cd "$OUTPUT_DIR"

cp -r "$TOFU_MODULE_DIR"/* .

echo "Running: tofu init"
# shellcheck disable=SC2086
if ! tofu init $TOFU_INIT_VARIABLES; then
  echo "" >&2
  echo "ERROR: tofu init failed in ${OUTPUT_DIR}" >&2
  echo "" >&2
  echo "  Aborting before apply: continuing would operate on the wrong state." >&2
  echo "" >&2
  echo "  Possible causes:" >&2
  echo "    - A previous action left a .terraform pointing at another backend key" >&2
  echo "    - The state bucket is unreachable or the credentials expired" >&2
  echo "" >&2
  echo "  How to fix:" >&2
  echo "    - Make sure each action uses its own OUTPUT_DIR" >&2
  echo "    - Remove ${OUTPUT_DIR}/.terraform and run the action again" >&2
  echo "" >&2
  exit 1
fi

echo "Running: tofu $TOFU_ACTION"
# shellcheck disable=SC2086
tofu "$TOFU_ACTION" -auto-approve $TOFU_VARIABLES
