#!/bin/bash
set -euo pipefail

# ---------------------------------------------------------------------------
# write_link_outputs — Reads Terraform outputs from the permissions module and
# writes them to the NP link attributes via the API.
#
# aws_secret_access_key is declared with export.secret = true in the link spec,
# so the platform delivers it to the application as a secret environment
# variable rather than a plain one.
# ---------------------------------------------------------------------------

cd "$OUTPUT_DIR"

LINK_ID=$(echo "$CONTEXT" | jq -r '.link.id')

# Read every output in one shot as JSON. `tofu output -raw` returns nothing for
# a value marked sensitive, which silently dropped the secret access key and
# left the application with credentials it could not authenticate with.
OUTPUTS=$(tofu output -json 2>/dev/null || echo '{}')

ACCESS_KEY_ID=$(echo "$OUTPUTS"     | jq -r '.aws_access_key_id.value     // ""')
SECRET_ACCESS_KEY=$(echo "$OUTPUTS" | jq -r '.aws_secret_access_key.value // ""')
IAM_USER_NAME=$(echo "$OUTPUTS"     | jq -r '.iam_user_name.value         // ""')
TABLE_NAME=$(echo "$OUTPUTS"        | jq -r '.table_name.value            // ""')
TABLE_REGION=$(echo "$OUTPUTS"      | jq -r '.region.value                // ""')

if [ -z "$SECRET_ACCESS_KEY" ]; then
  echo "ERROR: the access key was created but its secret could not be read." >&2
  echo "  Writing the link without it would hand the application credentials" >&2
  echo "  it cannot authenticate with." >&2
  exit 1
fi

if [ -z "$ACCESS_KEY_ID" ]; then
  echo "WARNING: No aws_access_key_id output found. Skipping attribute update."
  exit 0
fi

ATTRIBUTES=$(jq -n \
  --arg access_key_id     "$ACCESS_KEY_ID" \
  --arg secret_access_key "$SECRET_ACCESS_KEY" \
  --arg iam_user_name     "$IAM_USER_NAME" \
  --arg table_name        "$TABLE_NAME" \
  --arg table_region      "$TABLE_REGION" \
  '{
    aws_access_key_id:     $access_key_id,
    aws_secret_access_key: $secret_access_key,
    iam_user_name:         $iam_user_name,
    table_name:            $table_name,
    table_region:          $table_region
  }')

echo "Writing link attributes for link ${LINK_ID} (iam user: ${IAM_USER_NAME})"

np link patch --id "$LINK_ID" --body "{\"attributes\": $ATTRIBUTES}"

echo "Link attributes updated."
