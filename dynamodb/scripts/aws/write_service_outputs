#!/bin/bash
set -euo pipefail

# ---------------------------------------------------------------------------
# write_service_outputs — Reads Terraform outputs from the deployment module
# and writes them to the NP service attributes via the API.
#
# Fields with "export: true" in the service spec (table_name, table_arn,
# stream_arn, table_region) become env vars in apps when a link is activated.
#
# stream_arn matters beyond visibility: the trigger link reads it from the
# notification context to wire the stream to a Lambda function, instead of
# querying AWS for it.
# ---------------------------------------------------------------------------

cd "$OUTPUT_DIR"

SERVICE_ID=$(echo "$CONTEXT" | jq -r '.service.id')

TABLE_NAME=$(tofu output -raw table_name 2>/dev/null || echo "")
TABLE_ARN=$(tofu output -raw table_arn 2>/dev/null || echo "")
TABLE_ID=$(tofu output -raw table_id 2>/dev/null || echo "")
TABLE_REGION=$(tofu output -raw table_region 2>/dev/null || echo "")
STREAM_ARN=$(tofu output -raw stream_arn 2>/dev/null || echo "")

if [ -z "$TABLE_NAME" ]; then
  echo "WARNING: No table_name output found. Skipping attribute update."
  exit 0
fi

ATTRIBUTES=$(jq -n \
  --arg table_name    "$TABLE_NAME" \
  --arg table_arn     "$TABLE_ARN" \
  --arg table_id      "$TABLE_ID" \
  --arg table_region  "$TABLE_REGION" \
  --arg stream_arn    "$STREAM_ARN" \
  '{
    table_name:   $table_name,
    table_arn:    $table_arn,
    table_id:     $table_id,
    table_region: $table_region,
    stream_arn:   $stream_arn
  }')

echo "Writing service attributes for service ${SERVICE_ID}:"
echo "$ATTRIBUTES" | jq .

np service patch --id "$SERVICE_ID" --body "{\"attributes\": $ATTRIBUTES}"

echo "Service attributes updated."
